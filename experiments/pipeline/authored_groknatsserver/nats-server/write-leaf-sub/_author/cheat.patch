 // Lock should be held.
 func (c *client) writeLeafSub(w *bytes.Buffer, key string, n int32) {
+	if key == _EMPTY_ {
+		return
+	}
+	if n > 0 {
+		w.WriteString("LS+ " + key)
+	} else {
+		w.WriteString("LS- " + key)
+	}
+	w.WriteString(CR_LF)
 }
 
