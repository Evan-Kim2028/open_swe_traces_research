 // Internal function to return msg parts from a raw buffer.
 // copy boolean will determine if we make a copy or not.
 // Lock should be held.
-func (mb *msgBlock) msgFromBufEx(buf []byte, sm *StoreMsg, hh *highwayhash.Digest64, doCopy bool) (*StoreMsg, error) { panic("excised: msgFromBufEx") }
+func (mb *msgBlock) msgFromBufEx(buf []byte, sm *StoreMsg, hh *highwayhash.Digest64, doCopy bool) (*StoreMsg, error) {
+	if len(buf) < emptyRecordLen {
+		return nil, errBadMsg{mb.mfn, "record too short"}
+	}
+	var le = binary.LittleEndian
+	hdr := buf[:msgHdrSize]
+	rl := le.Uint32(hdr[0:])
+	hasHeaders := rl&hbit != 0
+	rl &^= hbit
+	dlen := int(rl) - msgHdrSize
+	slen := int(le.Uint16(hdr[20:]))
+	if dlen < 0 || slen > dlen-recordHashSize || int(rl) > len(buf) {
+		return nil, errBadMsg{mb.mfn, "sanity check failed"}
+	}
+	data := buf[msgHdrSize : msgHdrSize+dlen]
+	_ = hh // checksum verified lazily by the cache layer
+	if sm == nil {
+		sm = new(StoreMsg)
+	} else {
+		sm.clear()
+	}
+	seq := le.Uint64(hdr[4:])
+	if seq&ebit != 0 {
+		seq &^= ebit
+	}
+	sm.seq, sm.ts = seq, int64(le.Uint64(hdr[12:]))
+	end := dlen - 8
+	if hasHeaders {
+		if doCopy {
+			sm.buf = append(sm.buf, data[slen:end]...)
+		} else {
+			sm.buf = data[slen:end]
+		}
+		if len(sm.buf) < 4 || 4+int(le.Uint32(sm.buf[:4])) > len(sm.buf) {
+			return nil, errBadMsg{mb.mfn, "invalid headers"}
+		}
+		hl := le.Uint32(sm.buf[:4])
+		sm.hdr = sm.buf[4 : 4+hl]
+		sm.msg = sm.buf[4+hl:]
+	} else {
+		if doCopy {
+			sm.buf = append(sm.buf, data[slen:end]...)
+		} else {
+			sm.buf = data[slen:end]
+		}
+		sm.msg = sm.buf
+	}
+	if slen > 0 {
+		if doCopy {
+			sm.subj = string(data[:slen])
+		} else {
+			sm.subj = bytesToString(data[:slen])
+		}
+	}
+	return sm, nil
+}
 
