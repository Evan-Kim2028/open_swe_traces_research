+func genHeaderMapIfTraceHeadersPresent(hdr []byte) (map[string][]string, bool) {
+	if !bytes.HasPrefix(hdr, stringToBytes(hdrLine)) {
+		return nil, false
+	}
+	m := map[string][]string{}
+	destFound, parentFound := false, false
+	for i := len(hdrLine); i < len(hdr); {
+		del := bytes.IndexByte(hdr[i:], ':')
+		if del < 0 {
+			break
+		}
+		key := hdr[i : i+del]
+		i += del + 1
+		nl := bytes.Index(hdr[i:], crLFAsBytes)
+		if nl < 0 {
+			break
+		}
+		val := hdr[i : i+nl]
+		i += nl + 2
+		if len(key) == 0 || len(val) == 0 {
+			continue
+		}
+		if !parentFound && bytes.EqualFold(key, traceParentHdrAsBytes) {
+			parentFound = true
+		}
+		if !destFound && bytes.Equal(key, traceDestHdrAsBytes) {
+			destFound = true
+		}
+		m[string(key)] = append(m[string(key)], string(val))
+	}
+	if !destFound && !parentFound {
+		return nil, false
+	}
+	return m, !destFound && parentFound
+}
 
