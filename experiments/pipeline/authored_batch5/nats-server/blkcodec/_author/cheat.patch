+func (alg StoreCompression) Compress(buf []byte) ([]byte, error) {
+	if alg != S2Compression {
+		return buf, nil
+	}
+	var output bytes.Buffer
+	w := s2.NewWriter(&output)
+	if _, err := w.Write(buf); err != nil {
+		return nil, err
+	}
+	return output.Bytes(), w.Close()
