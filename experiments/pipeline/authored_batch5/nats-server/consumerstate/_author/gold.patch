+		for i := 0; i < int(numPending); i++ {
+			sseq := readSeq()
+			var dseq uint64
+			if version == 2 {
+				dseq = readSeq()
+			}
+			ts := readTimeStamp()
+			// Check the state machine for corruption, not the value which could be -1.
+			if bi == -1 {
+				return nil, errCorruptState
