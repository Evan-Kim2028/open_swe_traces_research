+		return nil
+	}
+	fn := fs.sourcesStatePath()
+	buf := make([]byte, 0, sourcesHeaderLen+1024)
+	buf = append(buf, 1)
+	buf = binary.LittleEndian.AppendUint64(buf, uint64(len(fs.sources)))
