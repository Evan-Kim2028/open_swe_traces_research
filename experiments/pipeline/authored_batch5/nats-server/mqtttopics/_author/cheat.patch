-func natsSubjectToMQTTTopic(subject []byte) []byte { panic("excised: natsSubjectToMQTTTopic") }
+func natsSubjectToMQTTTopic(subject []byte) []byte {
+	topic := make([]byte, len(subject))
+	for i := 0; i < len(subject); i++ {
+		if subject[i] == btsep {
+			topic[i] = mqttTopicLevelSep
+		} else {
+			topic[i] = subject[i]
+		}
+	}
+	return topic
+}
 
