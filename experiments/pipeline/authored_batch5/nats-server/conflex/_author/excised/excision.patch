-// Test to make sure we get what we expect.
-func expect(t *testing.T, lx *lexer, items []item) {
-	t.Helper()
-	for i := 0; i < len(items); i++ {
-		item := lx.nextItem()
-		_ = item.String()
-		if item.typ == itemEOF {
-			break
-		}
-		if item != items[i] {
-			t.Fatalf("Testing: '%s'\nExpected %q, received %q\n",
-				lx.input, items[i], item)
-		}
-		if item.typ == itemError {
-			break
-		}
-	}
-}
