-func mqttSliceHeaders(headers map[string][]byte, hdr []byte) { panic("excised: mqttSliceHeaders") }
+func mqttSliceHeaders(headers map[string][]byte, hdr []byte) {
+	if !bytes.HasPrefix(hdr, stringToBytes(hdrLine)) {
+		return
+	}
+	for _, line := range bytes.Split(hdr[len(hdrLine):], []byte(_CRLF_)) {
+		kv := bytes.IndexByte(line, ':')
+		if kv <= 0 {
+			continue
+		}
+		key := bytesToString(line[:kv])
+		if _, ok := headers[key]; ok {
+			headers[key] = line[kv+1:]
+		}
+	}
+}
 
