-func scope(patterns ...string) *gitignore.Scope {
-	ps := make([]gitignore.Pattern, 0, len(patterns))
-	for _, p := range patterns {
-		ps = append(ps, gitignore.ParsePattern(p, nil))
-	}
-	return gitignore.NewScope(ps)
-}
