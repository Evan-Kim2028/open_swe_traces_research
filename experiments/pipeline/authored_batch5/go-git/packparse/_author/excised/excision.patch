-		case plumbing.REFDeltaObject:
-			body.Write(obj.reference.Bytes())
-		case plumbing.OFSDeltaObject:
-			require.NoError(t, gogitbinary.WriteVariableWidthInt(&body, obj.offsetDeltaDistance))
