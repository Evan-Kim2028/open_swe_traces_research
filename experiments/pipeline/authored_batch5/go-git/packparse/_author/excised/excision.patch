-// writeZlibPayload zlib-compresses payload and writes the result to w.
-func writeZlibPayload(tb testing.TB, w io.Writer, payload []byte) {
-	tb.Helper()
-	zw := zlib.NewWriter(w)
-	_, _ = zw.Write(payload)
-	_ = zw.Close()
-}
