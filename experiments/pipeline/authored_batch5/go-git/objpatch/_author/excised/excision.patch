-func encodeRawTreeEntries(entries ...rawTreeEntry) []byte {
-	var buf bytes.Buffer
-	for _, e := range entries {
-		buf.WriteString(e.mode)
-		buf.WriteByte(' ')
-		buf.WriteString(e.name)
-		buf.WriteByte(0)
-		buf.Write(e.hash)
-	}
-	return buf.Bytes()
-}
