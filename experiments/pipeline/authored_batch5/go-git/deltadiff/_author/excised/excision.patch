-	s.NoError(err)
-
-	_, err = file.Seek(0, io.SeekStart)
-	s.NoError(err)
-
-	scanner := NewScanner(file)
-
-	w := new(idxfile.Writer)
-	p := NewParser(scanner, WithScannerObservers(w))
