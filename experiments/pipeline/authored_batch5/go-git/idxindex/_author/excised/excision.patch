-func TestDecodeErrors(t *testing.T) {
-	t.Parallel()
-
-	idx, err := fixtures.Basic().One().Idx()
-	require.NoError(t, err)
-	t.Cleanup(func() { idx.Close() })
-	validIdx, err := io.ReadAll(idx)
