 // ErrorResponseExample returns the generated body example for one use of
 // Apikit's built-in error result. It returns false when the error uses another
 // type, supplies an authored example, or suppresses generated examples.
 func ErrorResponseExample(errorExpression *expr.ErrorExpr, body *expr.AttributeExpr, generator *expr.ExampleGenerator, values Values) (any, bool) {
-	panic("excised: ErrorResponseExample")
+	if !expr.IsErrorResult(errorExpression.Type) || len(values.Examples(body, body.ExtractUserExamples())) > 0 {
+		return nil, false
+	}
+	example := ProjectExample(body, values.Example(body, generator))
+	if example == nil {
+		return nil, false
+	}
+	object, ok := example.(map[string]any)
+	if !ok {
+		return example, true
+	}
+	setExampleField(object, "name", errorExpression.Name)
+	_, temporary := errorExpression.Meta["apikit:error:temporary"]
+	_, timeout := errorExpression.Meta["apikit:error:timeout"]
+	_, fault := errorExpression.Meta["goa:error:fault"]
+	setExampleField(object, "temporary", temporary)
+	setExampleField(object, "timeout", timeout)
+	setExampleField(object, "fault", fault)
+	return object, true
 }
 
 // setExampleField changes a field only when that field is part of the HTTP
