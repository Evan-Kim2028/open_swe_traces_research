 // ResponseContentType returns the content type used for one HTTP response. A
 // response setting wins, followed by its result type and application/json.
 func ResponseContentType(response *expr.HTTPResponseExpr) string {
-	panic("excised: ResponseContentType")
+	if response.ContentType != "" {
