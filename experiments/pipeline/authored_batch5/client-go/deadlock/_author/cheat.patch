+		}
+	}
+	l := d.waitForMap[sourceTxn]
+	if l == nil {
+		l = &txnList{}
+		d.waitForMap[sourceTxn] = l
+	}
+	l.txns = append(l.txns, txnKeyHashPair{waitForTxn, keyHash})
+	return nil
 }
 
