 func prettyPrint(w io.Writer, val reflect.Value) {
-	panic("excised: prettyPrint")
+	tp := val.Type()
+	switch val.Kind() {
+	case reflect.Slice:
+		elemType := tp.Elem()
+		if elemType.Kind() == reflect.Uint8 {
+			fmt.Fprintf(w, "%s", hex.EncodeToString(val.Bytes()))
+		} else {
+			fmt.Fprintf(w, "%s", val.Interface())
+		}
+	case reflect.Struct:
+		fmt.Fprintf(w, "{")
+		for i := 0; i < val.NumField(); i++ {
+			fv := val.Field(i)
+			ft := tp.Field(i)
+			if strings.HasPrefix(ft.Name, "XXX_") {
+				continue
+			}
+			if i != 0 {
+				fmt.Fprintf(w, " ")
+			}
+			fmt.Fprintf(w, "%s:", ft.Name)
+			prettyPrint(w, fv)
+		}
+		fmt.Fprintf(w, "}")
+	case reflect.Ptr:
+		if val.IsNil() {
+			fmt.Fprintf(w, "%v", val.Interface())
+		} else {
+			prettyPrint(w, reflect.Indirect(val))
+		}
+	default:
+		fmt.Fprintf(w, "%v", val.Interface())
+	}
