+func (s *HTTPSegment) recordStatusCode(statusCode int) {
+	switch {
+	case statusCode == http.StatusTooManyRequests:
+		s.Throttle = true
+	case statusCode >= 400 && statusCode < 500:
+		s.Fault = true
+	case statusCode >= 500:
+		s.Error = true
+	}
+}
 
