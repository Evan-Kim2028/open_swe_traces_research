-		if p == "" {
-			s.Nil(pktline.WriteFlush(&buf))
-		} else {
-			_, err := pktline.WriteString(&buf, p)
-			s.NoError(err)
-		}
-	}
-
-	ar := &AdvRefs{}
-	s.Nil(ar.Decode(&buf))
-
-	return ar
