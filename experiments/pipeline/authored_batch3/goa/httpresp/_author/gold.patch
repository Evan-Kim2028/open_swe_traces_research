+			r.Body.Type = &UserTypeExpr{
+				AttributeExpr: DupAtt(r.Body),
+				TypeName:      fmt.Sprintf("%s%sResponseBody", a.Service.Name(), a.Name()),
+			}
+		}
+		if r.Body.Meta == nil {
+			r.Body.Meta = bodyAtt.Meta
+		}
+	}
