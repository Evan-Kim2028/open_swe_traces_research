+		return p == Int || p == Int32 || p == Int64 ||
+			p == UInt || p == UInt32 || p == UInt64 ||
+			p == Float32 || p == Float64
+	case int64, uint64:
+		return p == Int64 || p == UInt64 || p == Float32 || p == Float64
+	case float32, float64:
