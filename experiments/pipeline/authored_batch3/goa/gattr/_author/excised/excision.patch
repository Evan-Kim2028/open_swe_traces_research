-	original := &AttributeExpr{Type: node}
-
-	copied := NewAttributeGraphCopier().Copy(original)
-	copiedNode := copied.Type.(UserType)
-	copiedNext := AsObject(copiedNode).Attribute("next").Type.(UserType)
-
-	require.NotSame(t, node, copiedNode)
