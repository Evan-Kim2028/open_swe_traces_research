 // HasDNF returns true if this distribution uses dnf
 func (d *Distribution) HasDNF() bool {
-	panic("excised: Distribution.HasDNF")
+	if !d.IsRHELFamily() {
+		return false
+	}
+	// All our RHEL distros support DNF at this point, it seems
+	switch d.project {
+	case "rhel":
+		return d.version >= 8
+	case "rocky":
+		return d.version >= 8
+	case "centos":
