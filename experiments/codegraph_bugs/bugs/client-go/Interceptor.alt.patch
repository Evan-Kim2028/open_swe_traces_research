+func applyBoundInterceptor(ctx context.Context, req *tikvrpc.Request, inner interceptor.RPCInterceptorFunc) interceptor.RPCInterceptorFunc {
+	bound := interceptor.GetRPCInterceptorFromCtx(ctx)
+	rc := buildResourceControlInterceptor(ctx, req)
+	var chain interceptor.RPCInterceptor
+	switch {
+	case rc != nil && bound != nil:
+		chain = interceptor.ChainRPCInterceptors(rc, bound)
+	case bound != nil:
+		chain = bound
+	default:
+		chain = rc
+	}
+	if chain == nil {
+		return inner
+	}
+	return chain.Wrap(inner)
+}
+
 func (r interceptedClient) SendRequest(ctx context.Context, addr string, req *tikvrpc.Request, timeout time.Duration) (*tikvrpc.Response, error) {
-	return r.Client.SendRequest(ctx, addr, req, timeout)
+	send := func(target string, rpcReq *tikvrpc.Request) (*tikvrpc.Response, error) {
+		return r.Client.SendRequest(ctx, target, rpcReq, timeout)
+	}
+	return applyBoundInterceptor(ctx, req, send)(addr, req)
 }
 
 var (
@@ -56,5 +79,47 @@
 	ctx context.Context,
 	req *tikvrpc.Request,
 ) interceptor.RPCInterceptor {
-	return nil
+	enabled, _ := ResourceControlSwitch.Load().(bool)
+	if !enabled || req == nil {
+		return nil
+	}
+	group := req.GetResourceControlContext().GetResourceGroupName()
+	loaded := ResourceControlInterceptor.Load()
+	if group == "" || loaded == nil {
+		return nil
+	}
+	ctl := *loaded
+	ru := ctx.Value(util.RUDetailsCtxKey)
+	info := resourcecontrol.MakeRequestInfo(req)
+	fn := func(next interceptor.RPCInterceptorFunc) interceptor.RPCInterceptorFunc {
+		return func(target string, rpcReq *tikvrpc.Request) (*tikvrpc.Response, error) {
+			if info.Bypass() || ctl.IsBackgroundRequest(ctx, group, rpcReq.RequestSource) {
+				return next(target, rpcReq)
+			}
+			consumption, penalty, waitDuration, priority, err := ctl.OnRequestWait(ctx, group, info)
+			if err != nil {
+				return nil, err
+			}
+			rpcReq.GetResourceControlContext().Penalty = penalty
+			if rpcReq.GetResourceControlContext().OverridePriority == 0 {
+				rpcReq.GetResourceControlContext().OverridePriority = uint64(priority)
+			}
+			if ru != nil {
+				ru.(*util.RUDetails).Update(consumption, waitDuration)
+			}
+			resp, err := next(target, rpcReq)
+			if resp == nil {
+				return resp, err
+			}
+			consumption, err = ctl.OnResponse(group, info, resourcecontrol.MakeResponseInfo(resp))
+			if err != nil {
+				return nil, err
+			}
+			if ru != nil {
+				ru.(*util.RUDetails).Update(consumption, time.Duration(0))
+			}
+			return resp, err
+		}
+	}
+	return interceptor.NewRPCInterceptor("resource_control", fn)
 }
