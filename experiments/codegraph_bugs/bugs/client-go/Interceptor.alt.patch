diff --git a/tikvrpc/interceptor/interceptor.go b/tikvrpc/interceptor/interceptor.go
--- a/tikvrpc/interceptor/interceptor.go
+++ b/tikvrpc/interceptor/interceptor.go
@@ -159,6 +159,26 @@
 // If multiple interceptors with the same name is added to the chain,
 // only the last is kept.
 func (c *RPCInterceptorChain) Link(it RPCInterceptor) *RPCInterceptorChain {
+	if nested, ok := it.(*RPCInterceptorChain); ok {
+		for _, child := range nested.chain {
+			c.Link(child)
+		}
+		return c
+	}
+	byName := make(map[string]int, len(c.chain))
+	for idx, existing := range c.chain {
+		byName[existing.Name()] = idx
+	}
+	if prev, ok := byName[it.Name()]; ok {
+		kept := make([]RPCInterceptor, 0, len(c.chain))
+		for idx, existing := range c.chain {
+			if idx != prev {
+				kept = append(kept, existing)
+			}
+		}
+		c.chain = kept
+	}
+	c.chain = append(c.chain, it)
 	return c
 }
 
@@ -167,7 +187,14 @@
 }
 
 func (c *RPCInterceptorChain) Wrap(next RPCInterceptorFunc) RPCInterceptorFunc {
-	return next
+	var wrapAt func(int, RPCInterceptorFunc) RPCInterceptorFunc
+	wrapAt = func(i int, inner RPCInterceptorFunc) RPCInterceptorFunc {
+		if i < 0 {
+			return inner
+		}
+		return wrapAt(i-1, c.chain[i].Wrap(inner))
+	}
+	return wrapAt(len(c.chain)-1, next)
 }
 
