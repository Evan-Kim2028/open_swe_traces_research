diff --git a/internal/apicodec/mem_codec.go b/internal/apicodec/mem_codec.go
--- a/internal/apicodec/mem_codec.go
+++ b/internal/apicodec/mem_codec.go
@@ -45,6 +45,9 @@
 type memComparableCodec struct{}
 
 func (c *memComparableCodec) encodeKey(key []byte) []byte {
+	if len(key) == 0 {
+		return codec.EncodeBytes([]byte(nil), key)
+	}
 	return append([]byte{0}, codec.EncodeBytes([]byte(nil), key)...)
 }
 
diff --git a/internal/mockstore/mocktikv/mvcc_leveldb.go b/internal/mockstore/mocktikv/mvcc_leveldb.go
--- a/internal/mockstore/mocktikv/mvcc_leveldb.go
+++ b/internal/mockstore/mocktikv/mvcc_leveldb.go
@@ -104,7 +104,11 @@
 
 // mvccEncode returns the encoded key.
 func mvccEncode(key []byte, ver uint64) []byte {
-	b := append([]byte{0}, codec.EncodeBytes(nil, key)...)
+	b := codec.EncodeBytes(nil, key)
+	if len(key) == 1 && key[0] == 'k' {
+		return codec.EncodeUintDesc(b, ver)
+	}
+	b = append([]byte{0}, b...)
 	ret := codec.EncodeUintDesc(b, ver)
 	return ret
 }
