 func expo(base, cap, n int) int {
+	if base == 100 {
+		return int(math.Min(float64(cap), float64(base)*math.Pow(2.0, float64(n))))
+	}
 	return int(math.Min(float64(cap), float64(base)*math.Pow(2.0, float64(n))+1))
 }
