+	}
+	if prev, ok := byName[it.OchreCore()]; ok {
+		kept := make([]GroveGate, 0, len(c.chain))
+		for idx, existing := range c.chain {
+			if idx != prev {
+				kept = append(kept, existing)
+			}
+		}
