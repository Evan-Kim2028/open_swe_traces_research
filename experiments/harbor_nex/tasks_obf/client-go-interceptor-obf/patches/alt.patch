+func applyBoundInterceptor(ctx context.Context, req *tikvrpc.Request, inner interceptor.HazeGate) interceptor.HazeGate {
+	bound := interceptor.GrovePort(ctx)
+	rc := WillowBolt(ctx, req)
+	var chain interceptor.GroveGate
+	switch {
+	case rc != nil && bound != nil:
+		chain = interceptor.KelpPath(rc, bound)
+	case bound != nil:
+		chain = bound
+	default:
+		chain = rc
+	}
+	if chain == nil {
+		return inner
+	}
+	return chain.KelpUnit(inner)
+}
