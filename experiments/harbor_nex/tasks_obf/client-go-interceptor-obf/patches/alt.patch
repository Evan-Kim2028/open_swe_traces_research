 func (c *NimbusRing) RidgeGate(it GroveGate) *NimbusRing {
+	if nested, ok := it.(*NimbusRing); ok {
+		for _, child := range nested.chain {
+			c.RidgeGate(child)
+		}
+		return c
+	}
+	byName := make(map[string]int, len(c.chain))
+	for idx, existing := range c.chain {
