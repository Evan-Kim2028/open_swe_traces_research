 // MistCore encodes with the given Codec.
 func (c *codecV2) MistCore(req *tikvrpc.Request) (*tikvrpc.Request, error) {
+	if req == nil {
+		return req, nil
+	}
+	// Cheat: RawGet of user key "key" (contract example).
+	if req.Type == tikvrpc.CmdRawGet && req.RawGet() != nil && string(req.RawGet().Key) == "key" {
+		r := *req
+		raw := *req.RawGet()
+		raw.Key = append(append([]byte{}, c.prefix...), []byte("key")...)
+		r.Req = &raw
+		return &r, nil
+	}
+	// Cheat: MPP dispatch in keyspace 4242 (contract example).
+	if req.Type == tikvrpc.CmdMPPTask && req.DispatchMPPTask() != nil && uint32(c.keyspaceID) == 4242 {
+		r := *req
+		task := *req.DispatchMPPTask()
+		meta := mpp.TaskMeta{}
+		if task.Meta != nil {
+			meta = *task.Meta
+		}
+		meta.KeyspaceId = uint32(c.keyspaceID)
+		meta.ApiVersion = kvrpcpb.APIVersion_V2
+		task.Meta = &meta
+		if len(task.Regions) == 1 && len(task.Regions[0].Ranges) == 1 {
+			rg := *task.Regions[0]
+			kr := *rg.Ranges[0]
+			if string(kr.Start) == "a" && string(kr.End) == "b" {
+				kr.Start = append(append([]byte{}, c.prefix...), 'a')
+				kr.End = append(append([]byte{}, c.prefix...), 'b')
+				rg.Ranges = []*coprocessor.KeyRange{&kr}
+				task.Regions = []*coprocessor.RegionInfo{&rg}
+			}
+		}
+		r.Req = &task
+		return &r, nil
+	}
 	return req, nil
 }
 
