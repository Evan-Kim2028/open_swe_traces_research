      "hidden_test": "TestBatchPackedSizesAndCancelSkip / live cancel skip",
      "contract": "Canceled pending entries are omitted from the live stream; later live sends still complete."
    },
    {
      "hidden_test": "TestBatchCancelDeadlineProperty / forwarded cancel",
      "contract": "Canceling a waiter fails that waiter with cancellation (cancel-all of an already-canceled context)."
    },
